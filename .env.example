# Niobe Beauty — SimpleSpa branch credentials
# Each branch authenticates with a single API key:  Authorization: Bearer <KEY>
# There is no separate secret. Read vs write is controlled by the key's Mode in the
# SimpleSpa dashboard (1 = Read, 2 = Write, 3 = Read + Write). For auto-confirm and
# inventory writes each branch key must be Mode 3.
# Copy this file to .env and fill in the KEY for each branch.
# Set DEMO_MODE=false once real keys are in place to pull live data.

DEMO_MODE=true
PORT=3000
SIMPLESPA_BASE=https://my.simplespa.com/api/v1

# --- Branch API keys (one per branch, Mode 3) ---
AFRICAN_REGENT_KEY=your_african_regent_key
ALISA_HOTEL_KEY=your_alisa_hotel_key
HFC_C18_KEY=your_hfc_c18_key
CANTONMENTS_KEY=your_cantonments_key
EAST_LEGON_KEY=your_east_legon_key

# Low-stock threshold used to flag products in the staff view
LOW_STOCK_THRESHOLD=2

# Granularity (minutes) of the computed booking-availability grid (default 15).
SLOT_GRANULARITY=15

# --- Payments ---
# Primary gateway: hubtel (recommended for Ghana — mobile money + cards), expresspay or paystack.
PAYMENT_GATEWAY=hubtel
# Backup gateway — offered to the customer and used for automatic failover. '' to disable.
PAYMENT_GATEWAY_BACKUP=expresspay
# PAYMENT_DEMO=true simulates the checkout locally (no live keys needed).
# Set false and add the live/test keys below to run against the real gateways.
PAYMENT_DEMO=true
# In Ghana the customer bears the transaction fee. Set fee-bearer = customer at the gateway
# account level so the provider adds its exact fee on top of the deposit.
CUSTOMER_PAYS_FEES=true

# Hubtel — from your Hubtel dashboard -> API keys
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_MERCHANT_ACCOUNT=your_hubtel_merchant_or_pos_number

# expressPay — from your expressPay merchant dashboard
EXPRESSPAY_MERCHANT_ID=your_expresspay_merchant_id
EXPRESSPAY_API_KEY=your_expresspay_api_key
# sandbox for testing; switch to https://expresspaygh.com/api for live
EXPRESSPAY_BASE=https://sandbox.expresspaygh.com/api

# International rail (Option A) — customers abroad pay in this currency to the UK account,
# then funds are moved to Ghana as cedis. The customer sees the GHS value for assurance.
INTL_CURRENCY=GBP
FX_BUFFER_PCT=3
STRIPE_UK_SECRET=sk_live_or_test_xxxxxxxx

# GiftUp gift-card rail (redeem a card at booking + sell cards online). Key is a Bearer JWT
# from the GiftUp dashboard. Leave GIFTUP_TEST_MODE=true to exercise the flow against GiftUp
# test cards (no real cards/charges); set false for live issuance.
GIFTUP_API_KEY=
GIFTUP_TEST_MODE=false
# Online gift-card sales (amounts in GHS — the GiftUp store currency).
GIFTCARD_MIN=100
GIFTCARD_MAX=10000
GIFTCARD_VALIDITY_DAYS=90
# Customer service fee % added to a gift-card purchase (covers GiftUp commission + processing);
# mirrors the GiftUp storefront surcharge. Card keeps its face value; buyer pays value x (1+this%).
GIFTCARD_SURCHARGE_PCT=5

# Paystack (kept as an optional gateway)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

CURRENCY=GHS
# Minimum upfront deposit as a percentage of the service price (customer may also pay in full).
DEPOSIT_MIN_PERCENT=50
# Public URL of this service (used to build Paystack callback + webhook links).
PUBLIC_URL=http://localhost:3000
