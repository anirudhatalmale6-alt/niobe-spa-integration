# Niobe Beauty — SimpleSpa branch credentials
# Each branch authenticates with a single API key:  Authorization: Bearer <KEY>
# There is no separate secret. Read vs write is controlled by the key's Mode in the
# SimpleSpa dashboard (1 = Read, 2 = Write, 3 = Read + Write). For auto-confirm and
# inventory writes each branch key must be Mode 3.
# Copy this file to .env and fill in the KEY for each branch.
# Set DEMO_MODE=false once real keys are in place to pull live data.

DEMO_MODE=true
PORT=3000
SIMPLESPA_BASE=https://my.simplespa.com/api/v1

# --- Branch API keys (one per branch, Mode 3) ---
AFRICAN_REGENT_KEY=your_african_regent_key
ALISA_HOTEL_KEY=your_alisa_hotel_key
HFC_C18_KEY=your_hfc_c18_key
CANTONMENTS_KEY=your_cantonments_key
EAST_LEGON_KEY=your_east_legon_key

# Low-stock threshold used to flag products in the staff view
LOW_STOCK_THRESHOLD=2

# Granularity (minutes) of the computed booking-availability grid (default 15).
SLOT_GRANULARITY=15

# --- Payments ---
# Primary gateway: hubtel (recommended for Ghana — mobile money + cards), expresspay or paystack.
PAYMENT_GATEWAY=hubtel
# Backup gateway — offered to the customer and used for automatic failover. '' to disable.
PAYMENT_GATEWAY_BACKUP=expresspay
# PAYMENT_DEMO=true simulates the checkout locally (no live keys needed).
# Set false and add the live/test keys below to run against the real gateways.
PAYMENT_DEMO=true
# In Ghana the customer bears the transaction fee. Set fee-bearer = customer at the gateway
# account level so the provider adds its exact fee on top of the deposit.
CUSTOMER_PAYS_FEES=true

# Hubtel — from your Hubtel dashboard -> API keys
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_MERCHANT_ACCOUNT=your_hubtel_merchant_or_pos_number

# Per-branch settlement (optional). Give a branch its OWN Hubtel account number
# plus its own API ID/key and its online deposits settle into that branch instead
# of pooling in the central account above, so the branch sees the money and can
# reconcile it locally.
# All THREE values are needed per branch - an account addressed with the central
# account's key is not authorised and Hubtel rejects it. A branch missing any of
# the three falls back wholly to the central credentials above.
# NOTE: use the merchant ACCOUNT NUMBER, unpadded (e.g. 2021442). The zero-padded
# form (002021442) is rejected by both Hubtel endpoints. The *713*XXXX# strings
# are USSD codes a customer dials - they are NOT API identifiers.
EAST_LEGON_HUBTEL_ACCOUNT=
EAST_LEGON_HUBTEL_CLIENT_ID=
EAST_LEGON_HUBTEL_CLIENT_SECRET=
CANTONMENTS_HUBTEL_ACCOUNT=
CANTONMENTS_HUBTEL_CLIENT_ID=
CANTONMENTS_HUBTEL_CLIENT_SECRET=
AFRICAN_REGENT_HUBTEL_ACCOUNT=
AFRICAN_REGENT_HUBTEL_CLIENT_ID=
AFRICAN_REGENT_HUBTEL_CLIENT_SECRET=
HFC_C18_HUBTEL_ACCOUNT=
HFC_C18_HUBTEL_CLIENT_ID=
HFC_C18_HUBTEL_CLIENT_SECRET=
ALISA_HOTEL_HUBTEL_ACCOUNT=
ALISA_HOTEL_HUBTEL_CLIENT_ID=
ALISA_HOTEL_HUBTEL_CLIENT_SECRET=

# expressPay — from your expressPay merchant dashboard
EXPRESSPAY_MERCHANT_ID=your_expresspay_merchant_id
EXPRESSPAY_API_KEY=your_expresspay_api_key
# sandbox for testing; switch to https://expresspaygh.com/api for live
EXPRESSPAY_BASE=https://sandbox.expresspaygh.com/api

# Per-branch expressPay settlement, same idea as the Hubtel block above.
# The api-key is sent alongside merchant-id on EVERY call, so it authenticates that
# one merchant account: a branch needs BOTH its own merchant ID and its own key.
# Supplying only one of the two falls back to the central account above (no failure).
# NOTE: expressPay whitelists the calling server per account. Every account below
# must have this server's public IP whitelisted or submit.php answers
# {"status":4,"message":"Invalid API Credentials. IP - <ip>"}  (4 = Invalid IP).
EAST_LEGON_EXPRESSPAY_MERCHANT_ID=
EAST_LEGON_EXPRESSPAY_API_KEY=
CANTONMENTS_EXPRESSPAY_MERCHANT_ID=
CANTONMENTS_EXPRESSPAY_API_KEY=
AFRICAN_REGENT_EXPRESSPAY_MERCHANT_ID=
AFRICAN_REGENT_EXPRESSPAY_API_KEY=
HFC_C18_EXPRESSPAY_MERCHANT_ID=
HFC_C18_EXPRESSPAY_API_KEY=
ALISA_HOTEL_EXPRESSPAY_MERCHANT_ID=
ALISA_HOTEL_EXPRESSPAY_API_KEY=

# International rail (Option A) — customers abroad pay in this currency to the UK account,
# then funds are moved to Ghana as cedis. The customer sees the GHS value for assurance.
INTL_CURRENCY=GBP
FX_BUFFER_PCT=3
# Flat uplift added to a foreign charge, in the charge currency, on top of FX_BUFFER_PCT.
# Covers Stripe's fixed 20p-per-payment fee, which a percentage alone can never cover on
# small payments. 0 = off.
FX_FIXED_UPLIFT=0
STRIPE_UK_SECRET=sk_live_or_test_xxxxxxxx

# GiftUp gift-card rail (redeem a card at booking + sell cards online). Key is a Bearer JWT
# from the GiftUp dashboard. Leave GIFTUP_TEST_MODE=true to exercise the flow against GiftUp
# test cards (no real cards/charges); set false for live issuance.
GIFTUP_API_KEY=
GIFTUP_TEST_MODE=false
# Online gift-card sales (amounts in GHS — the GiftUp store currency).
GIFTCARD_MIN=100
GIFTCARD_MAX=10000
GIFTCARD_VALIDITY_DAYS=90
# Customer service fee % added to a gift-card purchase (covers GiftUp commission + processing);
# mirrors the GiftUp storefront surcharge. Card keeps its face value; buyer pays value x (1+this%).
GIFTCARD_SURCHARGE_PCT=5

# Paystack (kept as an optional gateway)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

CURRENCY=GHS
# Minimum upfront deposit as a percentage of the service price (customer may also pay in full).
DEPOSIT_MIN_PERCENT=50
# Public URL of this service (used to build Paystack callback + webhook links).
PUBLIC_URL=http://localhost:3000

# --- Secure-or-release (no-show) engine ---
# Master switch for the periodic release sweep. Off until Niobe explicitly arms it.
RELEASE_ENABLED=false
# DRY_RUN (default on): report what WOULD be released, write nothing to SimpleSpa.
# Set false only after watching the dry-run candidates on live data and signing off.
RELEASE_DRY_RUN=true
# Scope: 'tracked' = only holds our booking funnel has seen (walk-ins never touched);
# 'all' = also release ANY unsecured New/Rebooked past deadline (fuller closure).
RELEASE_SCOPE=tracked
# Grace window (minutes) before an unsecured hold is released.
RELEASE_GRACE_MINUTES=60
# Generous window (business minutes) for untracked/existing bookings under scope=all
# ("front desk calls to confirm; cancel unallocated by Monday"). Default ~1 business day.
RELEASE_UNTRACKED_GRACE_MINUTES=540
# Open the two hotel branches (Alisa, African Regent) on Sundays when required.
HOTEL_SUNDAY_OPEN=false
# How often the sweep runs (ms).
RELEASE_SWEEP_MS=300000
# Per-branch opening hours as JSON, used to make the release deadline business-hours
# aware for staff-authorised routes (credit / existing gift card / prepaid / bank transfer)
# so an overnight or closing-hours hold is not released before staff could act.
# Weekday keys 0=Sun..6=Sat. Either a flat map (applies to all branches) or
# {"default":{...},"east_legon":{...}}. Omit to use built-in defaults (Mon-Sat).
# BUSINESS_HOURS={"default":{"1":{"open":"09:00","close":"19:00"},"2":{"open":"09:00","close":"19:00"},"3":{"open":"09:00","close":"19:00"},"4":{"open":"09:00","close":"19:00"},"5":{"open":"09:00","close":"19:00"},"6":{"open":"09:00","close":"18:00"}}}

# Opening-hours source for the no-show release timer:
#  'simplespa' (default) = derive each branch's hours from its SimpleSpa staff roster
#   (a hotel opened on a Sunday in SimpleSpa opens here automatically); falls back to
#   static hours if a branch has no roster. 'config' = use static hours only.
HOURS_SOURCE=simplespa
DERIVED_HOURS_TTL_MS=1800000

# --- Notifications: deposit-link email via Microsoft Graph (M365, app-only) ---
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_FROM=paidforbooking@niobebeauty.com
# Mail to Niobe's OWN inboxes ("this guest says the treatment is already paid for") is
# switched separately from mail to customers — one flag for both would mean either
# silencing the front desk or starting customer emails nobody asked for.
NOTIFY_STAFF_EMAIL_ENABLED=false
# Each branch's booking inbox. A branch without one falls back to BOOKING_EMAIL; with
# neither, the claim is logged as a WARNING and reaches nobody.
EAST_LEGON_BOOKING_EMAIL=
CANTONMENTS_BOOKING_EMAIL=
AFRICAN_REGENT_BOOKING_EMAIL=
HFC_C18_BOOKING_EMAIL=
ALISA_HOTEL_BOOKING_EMAIL=
BOOKING_EMAIL=
# How long the branch email waits for the guest's payment history before sending without
# it (the lookup pages 180 days of transactions and took ~5s live).
CLAIM_EVIDENCE_WAIT_MS=12000
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Notifications: deposit-link SMS via Hubtel (separate SMS API credentials) ---
# Hubtel's SMS/Messaging key is SEPARATE from the checkout key. Create it under
# Hubtel > SMS API Keys; it has its own Client ID + Client Secret. The Quick SMS
# endpoint (sms.hubtel.com/v1/messages/send) authenticates by clientid/clientsecret
# query params. The sender ID (HUBTEL_SMS_SENDER) must be an APPROVED sender.
NOTIFY_SMS_ENABLED=false
HUBTEL_SMS_SENDER=NIOBE
HUBTEL_SMS_CLIENT_ID=your_hubtel_sms_client_id
HUBTEL_SMS_CLIENT_SECRET=your_hubtel_sms_client_secret

# --- Auto-send deposit link + pre-release reminder (turn on WITH go-live) ---
NOTIFY_AUTOSEND_ENABLED=false
NOTIFY_FRESH_MINUTES=180
REMINDER_LEAD_MINUTES=15

# --- Per-branch front-desk holds view (/desk/<branchId>) ---
# The read-only per-branch view is only reachable during office hours (Ghana=GMT)
# so it can't be opened on personal phones after hours. The all-branch central
# monitor view (/holds.html) is NOT time-restricted. Each /desk/<branch> URL is
# protected by its own nginx Basic Auth login (see deploy/DEPLOY.md).
DESK_OPEN_HOUR=8
DESK_CLOSE_HOUR=19
