# Niobe Beauty — SimpleSpa branch credentials
# Each branch authenticates as  Authorization: Bearer <KEY>:<SECRET>
# Copy this file to .env and fill in the KEY and SECRET for each branch.
# Set DEMO_MODE=false once real credentials are in place to pull live data.

DEMO_MODE=true
PORT=3000
SIMPLESPA_BASE=https://my.simplespa.com/api/v1

# --- Branch credentials (KEY:SECRET) ---
AFRICAN_REGENT_KEY=your_african_regent_key
AFRICAN_REGENT_SECRET=your_african_regent_secret

ALISA_HOTEL_KEY=your_alisa_hotel_key
ALISA_HOTEL_SECRET=your_alisa_hotel_secret

HFC_C18_KEY=your_hfc_c18_key
HFC_C18_SECRET=your_hfc_c18_secret

CANTONMENTS_KEY=your_cantonments_key
CANTONMENTS_SECRET=your_cantonments_secret

EAST_LEGON_KEY=your_east_legon_key
EAST_LEGON_SECRET=your_east_legon_secret

# Low-stock threshold used to flag products in the staff view
LOW_STOCK_THRESHOLD=2

# --- Payments ---
# Active gateway: hubtel (recommended for Ghana — mobile money + cards) or paystack.
PAYMENT_GATEWAY=hubtel
# PAYMENT_DEMO=true simulates the checkout locally (no live keys needed).
# Set false and add the live/test keys below to run against the real gateway.
PAYMENT_DEMO=true

# Hubtel — from your Hubtel dashboard -> API keys
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_MERCHANT_ACCOUNT=your_hubtel_merchant_or_pos_number

# Paystack (kept as a fallback gateway)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

CURRENCY=GHS
# Minimum upfront deposit as a percentage of the service price (customer may also pay in full).
DEPOSIT_MIN_PERCENT=50
# Public URL of this service (used to build Paystack callback + webhook links).
PUBLIC_URL=http://localhost:3000
